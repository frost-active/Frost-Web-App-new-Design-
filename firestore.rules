rules_version = '2';

service cloud.firestore {
  match /databases/{db}/documents {
    // Existing global device binding records keep the app's boundUid schema.
    match /deviceBindings/{bindingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && !exists(/databases/$(db)/documents/deviceBindings/$(bindingId))
        && request.resource.data.boundUid == request.auth.uid
        && request.resource.data.boundEmail == request.auth.token.email
        && request.resource.data.macAddress is string
        && request.resource.data.boundUid is string
        && request.resource.data.boundEmail is string
        && request.resource.data.boundAt == request.time;
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;

      match /devices/{macId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;

        match /{document=**} {
          allow read, write: if request.auth != null && request.auth.uid == uid;
        }
      }

      match /notifications/{notificationId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create, delete: if false;
        allow update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']);
      }

    }

    match /challenges/{challengeId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participantIds;
      allow create, update, delete: if false;

      match /{subcollection}/{documentId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(db)/documents/challenges/$(challengeId)).data.participantIds;
        allow create, update, delete: if false;
      }
    }

    match /devices/{mac}/statistics/{date} {
      allow read, write: if request.auth != null
        && exists(/databases/$(db)/documents/deviceBindings/$(mac))
        && get(/databases/$(db)/documents/deviceBindings/$(mac)).data.boundUid == request.auth.uid;
    }
  }
}
