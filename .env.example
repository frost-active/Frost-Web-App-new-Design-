# Required for Web Bluetooth access to the custom ESP32 GATT characteristic.
# Set this to the service UUID used by the firmware (not CHAR_UUID).
VITE_FROST_SERVICE_UUID=debc9a78-5634-12ef-cdab-89674523f14a

# Publicly published Google Sheets CSV URL with columns: music,music_id.
# See README.md for how to publish the sheet and get this URL.
VITE_MUSIC_SHEET_CSV_URL=
