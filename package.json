{
  "name": "frost-aura-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint src/features/challenges src/components/configure/store.ts src/components/configure/types.ts src/config/syncedConfig.ts src/HomeScreen.tsx src/pages/ConfigurePage.tsx src/services/userService.ts functions/index.js functions/src/challenges rules-tests",
    "preview": "vite preview",
    "test": "node --import tsx --test",
    "test:rules": "firebase emulators:exec --only firestore --project demo-frost-challenges \"node --test rules-tests/firestoreRules.rules.mjs\""
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-tools": "^15.34.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.1.3"
  }
}
